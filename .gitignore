# PN-CLT — Git Ignore
# ==================

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
.venv/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Report & Document Artifacts (excluded)
Report/
Report/**
*.docx
*.pdf
*.xlsx
*.pptx

# Images & Visual Artifacts (excluded per project specification)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.webp
*.ico

# Large Model Binary Files (regenerate from training scripts)
models/*
!models/.gitkeep

# Raw Audio Datasets (download via scripts/download_sample_data.py)
data/**/*.wav
data/**/*.WAV
data/**/*.mp3
data/**/*.flac
data/**/*.ogg
!data/**/.gitkeep

# Results cache & logs (regenerated by pipelines)
results/figures/*
!results/figures/.gitkeep
results/reports/*
!results/reports/.gitkeep

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Temporary
*.tmp
*.bak
scratch/
